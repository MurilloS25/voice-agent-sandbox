{
  "id": "06-pick-second-slot",
  "category": "task",
  "description": "A visitor picks the second offered time and receives a review, not a booking.",
  "turns": [
    {
      "user": "Times for a flat repair on Tuesday October 6?",
      "script": [
        {
          "tool_calls": [
            { "name": "find_available_slots", "args": { "service_id": "flat-repair", "date": "2026-10-06" } }
          ]
        },
        { "text": "S1 is 09:00 and S2 is 09:30." }
      ],
      "expect": { "outcome": "completed", "tools_called_in_order": ["find_available_slots"] }
    },
    {
      "user": "The second one, please.",
      "script": [
        { "tool_calls": [{ "name": "prepare_booking_review", "args": { "slot_id": "S2" } }] },
        { "text": "I prepared a review for 09:30. It is shown below; nothing is booked until you press Confirm booking." }
      ],
      "expect": {
        "outcome": "completed",
        "tools_called_in_order": ["prepare_booking_review"],
        "review_ready": true,
        "reply_should_mention_any": ["Confirm booking"],
        "claims_no_booking": true
      }
    }
  ]
}
