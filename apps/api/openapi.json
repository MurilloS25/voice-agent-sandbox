{
  "components": {
    "schemas": {
      "AppointmentProposalRequest": {
        "properties": {
          "service_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Service Id",
            "type": "string"
          },
          "start": {
            "description": "Requested slot start. Must include a UTC offset.",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "service_id",
          "start"
        ],
        "title": "AppointmentProposalRequest",
        "type": "object"
      },
      "AppointmentProposalResponse": {
        "description": "What confirming would book. Nothing has been saved yet.",
        "properties": {
          "customer_alias": {
            "description": "Fictional demo name the server assigned.",
            "title": "Customer Alias",
            "type": "string"
          },
          "end": {
            "description": "End, UTC. Computed by the server.",
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "proposal_token": {
            "description": "Signed, short-lived. Send it back to confirm.",
            "title": "Proposal Token",
            "type": "string"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceResponse"
          },
          "start": {
            "description": "Start, UTC.",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "proposal_token",
          "expires_at",
          "service",
          "start",
          "end",
          "timezone",
          "customer_alias"
        ],
        "title": "AppointmentProposalResponse",
        "type": "object"
      },
      "AppointmentResponse": {
        "description": "What the schedule service confirmed and saved. Rendered from the saved row only.",
        "properties": {
          "bench": {
            "title": "Bench",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "customer_alias": {
            "title": "Customer Alias",
            "type": "string"
          },
          "end": {
            "description": "End, UTC.",
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "service": {
            "$ref": "#/components/schemas/AppointmentServiceResponse"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "start": {
            "description": "Start, UTC.",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "service",
          "start",
          "end",
          "timezone",
          "customer_alias",
          "bench",
          "source",
          "created_at"
        ],
        "title": "AppointmentResponse",
        "type": "object"
      },
      "AppointmentServiceResponse": {
        "description": "The service as it was when the appointment was booked (a saved snapshot).",
        "properties": {
          "duration_minutes": {
            "title": "Duration Minutes",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyResponse"
          }
        },
        "required": [
          "id",
          "name",
          "duration_minutes",
          "price"
        ],
        "title": "AppointmentServiceResponse",
        "type": "object"
      },
      "AvailabilityResponse": {
        "properties": {
          "date": {
            "description": "The requested date, interpreted in the business timezone.",
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "service_id": {
            "title": "Service Id",
            "type": "string"
          },
          "slots": {
            "items": {
              "$ref": "#/components/schemas/SlotResponse"
            },
            "title": "Slots",
            "type": "array"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "service_id",
          "date",
          "timezone",
          "slots"
        ],
        "title": "AvailabilityResponse",
        "type": "object"
      },
      "BookingWindowResponse": {
        "properties": {
          "first_date": {
            "description": "First bookable date in the business timezone.",
            "format": "date",
            "title": "First Date",
            "type": "string"
          },
          "last_date": {
            "description": "Last bookable date in the business timezone.",
            "format": "date",
            "title": "Last Date",
            "type": "string"
          }
        },
        "required": [
          "first_date",
          "last_date"
        ],
        "title": "BookingWindowResponse",
        "type": "object"
      },
      "BusinessResponse": {
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "booking_window": {
            "$ref": "#/components/schemas/BookingWindowResponse"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "hours": {
            "items": {
              "$ref": "#/components/schemas/OpeningIntervalResponse"
            },
            "title": "Hours",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "slot_interval_minutes": {
            "title": "Slot Interval Minutes",
            "type": "integer"
          },
          "tagline": {
            "title": "Tagline",
            "type": "string"
          },
          "timezone": {
            "description": "IANA timezone of the business.",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "tagline",
          "address",
          "phone",
          "timezone",
          "currency",
          "slot_interval_minutes",
          "hours",
          "booking_window"
        ],
        "title": "BusinessResponse",
        "type": "object"
      },
      "ConfirmAppointmentRequest": {
        "properties": {
          "confirm": {
            "const": true,
            "description": "Must be true: the user explicitly confirmed.",
            "title": "Confirm",
            "type": "boolean"
          },
          "proposal_token": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Proposal Token",
            "type": "string"
          }
        },
        "required": [
          "proposal_token",
          "confirm"
        ],
        "title": "ConfirmAppointmentRequest",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorFieldDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorFieldDetail": {
        "properties": {
          "issue": {
            "description": "Machine-readable validation issue type.",
            "title": "Issue",
            "type": "string"
          },
          "loc": {
            "description": "Location of the invalid field.",
            "items": {
              "type": "string"
            },
            "title": "Loc",
            "type": "array"
          }
        },
        "required": [
          "loc",
          "issue"
        ],
        "title": "ErrorFieldDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MoneyResponse": {
        "properties": {
          "amount_minor": {
            "description": "Amount in the currency's minor unit (e.g. cents).",
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "description": "ISO 4217 currency code.",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "title": "MoneyResponse",
        "type": "object"
      },
      "OpeningIntervalResponse": {
        "properties": {
          "end": {
            "description": "Local closing time, HH:MM.",
            "pattern": "^\\d{2}:\\d{2}$",
            "title": "End",
            "type": "string"
          },
          "start": {
            "description": "Local opening time, HH:MM.",
            "pattern": "^\\d{2}:\\d{2}$",
            "title": "Start",
            "type": "string"
          },
          "weekday": {
            "description": "0 = Monday ... 6 = Sunday.",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Weekday",
            "type": "integer"
          }
        },
        "required": [
          "weekday",
          "start",
          "end"
        ],
        "title": "OpeningIntervalResponse",
        "type": "object"
      },
      "ServiceResponse": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "duration_minutes": {
            "title": "Duration Minutes",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyResponse"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "duration_minutes",
          "price"
        ],
        "title": "ServiceResponse",
        "type": "object"
      },
      "ServicesResponse": {
        "properties": {
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceResponse"
            },
            "title": "Services",
            "type": "array"
          }
        },
        "required": [
          "services"
        ],
        "title": "ServicesResponse",
        "type": "object"
      },
      "SlotResponse": {
        "properties": {
          "end": {
            "description": "Slot end, UTC.",
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "start": {
            "description": "Slot start, UTC.",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "SlotResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Fictional business data, deterministic availability, and explicit-confirmation booking. Demo data only.",
    "title": "Voice Agent Sandbox API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/appointment-proposals": {
      "post": {
        "description": "Describe what booking this slot would do. Nothing is saved.",
        "operationId": "create_appointment_proposal_v1_appointment_proposals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentProposalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentProposalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown service."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "slot_unavailable: every bench is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "validation_error, date_out_of_range or slot_not_offered."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Storage unavailable."
          }
        },
        "summary": "Create Appointment Proposal",
        "tags": [
          "appointments"
        ]
      }
    },
    "/v1/appointments": {
      "post": {
        "description": "The only write. Requires a valid proposal token and an explicit `confirm: true`.",
        "operationId": "confirm_appointment_route_v1_appointments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmAppointmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            },
            "description": "The proposal had already been confirmed: the original appointment."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "slot_unavailable (just taken) or proposal_stale (details changed)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "validation_error, proposal_invalid, proposal_expired, or slot_not_offered (the time is no longer offered, for example it is now inside the lead time)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Storage unavailable."
          }
        },
        "summary": "Confirm Appointment Route",
        "tags": [
          "appointments"
        ]
      }
    },
    "/v1/appointments/{appointment_id}": {
      "get": {
        "operationId": "read_appointment_v1_appointments__appointment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "appointment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Appointment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown appointment."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid appointment id."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Storage unavailable."
          }
        },
        "summary": "Read Appointment",
        "tags": [
          "appointments"
        ]
      }
    },
    "/v1/business": {
      "get": {
        "operationId": "read_business_v1_business_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Storage unavailable."
          }
        },
        "summary": "Read Business",
        "tags": [
          "business"
        ]
      }
    },
    "/v1/services": {
      "get": {
        "operationId": "list_services_v1_services_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Storage unavailable."
          }
        },
        "summary": "List Services",
        "tags": [
          "business"
        ]
      }
    },
    "/v1/services/{service_id}/availability": {
      "get": {
        "operationId": "read_availability_v1_services__service_id__availability_get",
        "parameters": [
          {
            "in": "path",
            "name": "service_id",
            "required": true,
            "schema": {
              "title": "Service Id",
              "type": "string"
            }
          },
          {
            "description": "Local date in the business timezone (YYYY-MM-DD).",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "description": "Local date in the business timezone (YYYY-MM-DD).",
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown service."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request or date outside the window."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Storage unavailable."
          }
        },
        "summary": "Read Availability",
        "tags": [
          "availability"
        ]
      }
    }
  }
}
