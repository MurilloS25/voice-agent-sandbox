# Copy to `.env` (git-ignored) for local development, or generate it with
#   python -m uv run python -m voice_agent_api.devtools.secrets generate
# Placeholders only: never put a real value in this file.

# `memory` (default, no database) or `postgres`.
APPOINTMENT_STORE=memory
BUSINESS_ID=quillwheel

# Required in postgres mode. Generate the first two with the secrets devtool.
PROPOSAL_SIGNING_KEY=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=CHANGE_ME
DB_USER=voice_agent_api.CHANGE_ME
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=verify-full
DB_SSLROOTCERT=CHANGE_ME

# Text agent. `disabled` (default) needs no key and no model; the agent endpoint answers 503.
# Set `groq` only after choosing a model from Groq's current documentation (docs/decisions/0008-*).
# Add the real key to your own .env by hand; never put one in this file.
AGENT_PROVIDER=disabled
GROQ_API_KEY=CHANGE_ME
AGENT_MODEL=CHANGE_ME
AGENT_TEMPERATURE=0
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_REASONING_EFFORT=low
AGENT_REASONING_CONTROL=include_reasoning

# Voice input (speech-to-text). `disabled` (default) needs nothing; the endpoint answers 503.
# `fake` is for tests and offline development only and needs APP_ENV=development or test.
# `groq` reuses GROQ_API_KEY and needs SPEECH_MODEL from Groq's current documentation
# (docs/decisions/0009-*). Add real values to your own .env by hand; never put one in this file.
APP_ENV=production
SPEECH_PROVIDER=disabled
SPEECH_MODEL=CHANGE_ME
SPEECH_TIMEOUT_S=6
SPEECH_READ_TIMEOUT_S=3
SPEECH_MAX_AUDIO_BYTES=524288
SPEECH_MAX_CONCURRENT=2
