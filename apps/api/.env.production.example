# Production settings, by NAME ONLY. Nothing here is a real value and nothing may be: every
# secret is entered in the hosting dashboard (Render: environment variable with "sync: false"),
# never in this file, never in the repository, never in a build argument.
# The API refuses to start in production if a required value is missing or unsafe, and names
# only the setting that failed.

APP_ENV=production                       # the default; stated for clarity

# --- Required secrets (dashboard only; each one different from the others and from dev) -------
API_SHARED_SECRET=                       # >= 32 random characters; the web tier sends it as a bearer token
PROPOSAL_SIGNING_KEY=                    # base64url, 32 random bytes; rotating it invalidates open reviews
DB_PASSWORD=                             # the single password of the voice_agent_api role (shared with local .env; rotate both together)
GROQ_API_KEY=                            # key of the dedicated production Groq project

# --- Database: shared pooler, session mode, verified TLS --------------------------------------
APPOINTMENT_STORE=postgres               # required whenever a provider is enabled (the budget lives here)
DB_HOST=                                 # the session-pooler host of the existing project
DB_PORT=5432
DB_NAME=postgres
DB_USER=                                 # voice_agent_api.<project ref>
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/app/certs/supabase-ca.crt # public CA certificate shipped in the image (see apps/api/certs/README.md)
DB_POOL_MAX=5

# --- Providers --------------------------------------------------------------------------------
AGENT_PROVIDER=groq
AGENT_MODEL=                             # from ADR 0008 (a model id is configuration, never code)
SPEECH_PROVIDER=groq
SPEECH_MODEL=                            # from ADR 0009

# --- Limits (defaults shown; production accepts lower values, never higher than the ceilings) --
RATE_LIMIT_ENABLED=true
RATE_AGENT_CLIENT_PER_MIN=3              # ceiling 20; never above the overall value
RATE_AGENT_OVERALL_PER_MIN=3             # ceiling 20; from the provider's tokens-per-minute limit
RATE_SPEECH_CLIENT_PER_MIN=6             # ceiling 20
RATE_SPEECH_OVERALL_PER_MIN=6            # ceiling 20
RATE_WRITE_CLIENT_PER_MIN=6              # ceiling 30
RATE_WRITE_OVERALL_PER_MIN=12            # ceiling 60
RATE_READ_CLIENT_PER_MIN=60              # ceiling 120
RATE_READ_OVERALL_PER_MIN=300            # ceiling 600
AGENT_MAX_IN_FLIGHT=2
SPEECH_MAX_CONCURRENT=2
SPEECH_MAX_AUDIO_BYTES=262144
JSON_BODY_LIMIT_BYTES=16384

# --- Daily budget (UTC day, stored as aggregate numbers in PostgreSQL) ------------------------
BUDGET_ENFORCED=true
AGENT_DAILY_TOKEN_BUDGET=100000          # half of the provider's free daily limit
AGENT_TURN_TOKEN_RESERVE=4000
SPEECH_DAILY_AUDIO_SECONDS=14400         # half of the provider's free daily limit
SPEECH_MIN_BILLED_SECONDS=10
SPEECH_MIN_BYTES_PER_SECOND=3000

# --- Must stay off in production (the API refuses to start otherwise) -------------------------
# API_AUTH_MODE=disabled
# LOG_TRACEBACKS=true
